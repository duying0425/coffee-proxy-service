# ==========================================
# R Café 飞书点单开放服务配置模版
# 复制本文件为 .env 并按需填写配置
# ==========================================

# 飞书秒搭咖啡应用凭证 (从浏览器 F12 网络请求 Header 中提取，有效期约 30 天)
BASE_URL=https://your-tenant.feishuapp.com/app/your_app_id
CSRF_TOKEN=your_csrf_token_here
SESSION_TOKEN=your_session_jwt_here
WEB_DID=your_web_did_here

# 服务监听配置
HOST=0.0.0.0
PORT=8085

# 风控与配额
MAX_ORDERS_PER_PERSON_DAILY=2
ALLOW_ORDERING=true

# 运行模式：false 为正常下单扣豆营业，true 为演练模式 (全流程 Mock，不扣豆)
DRY_RUN=false

# 飞书多维表格通知 Webhook (制作完成就绪推送，留空则不推送)
FEISHU_NOTIFY_WEBHOOK=https://your-company.feishu.cn/base/workflow/webhook/event/your_event_id

# 飞书多维表格分享表单链接 (在网页顶部提供直达实名问卷入口，留空则不显示)
FEISHU_FORM_URL=https://your-company.feishu.cn/share/base/form/your_form_token
